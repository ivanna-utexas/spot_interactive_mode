<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_dog_mode</name>
  <version>0.0.1</version>
  <description>Auto Dog Mode: person-aware dog-like gaze behavior for Spot (greet + track via body pose).</description>
  <maintainer email="dylansp.dev@gmail.com">Dylan Pina</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>people_detector</depend>
  <depend>spot_msgs</depend>

  <exec_depend>spot_eye_animation_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
