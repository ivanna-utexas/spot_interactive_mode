<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_interactive_mode</name>
  <version>0.0.1</version>
  <description>Switchable STAY / FOLLOW / DANCE interactive mode for Spot.</description>
  <maintainer email="ivannaac@utexas.edu">Ivanna Aleman-Coronado</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>spot_msgs</depend>
  <depend>interactive_mode_msgs</depend>

  <exec_depend>spot_dog_mode</exec_depend>
  <exec_depend>people_detector</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
